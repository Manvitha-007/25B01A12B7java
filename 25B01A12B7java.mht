            System.out.println(e);
        }
    }
}

class Welcome extends Thread {
    // write your code here
	int n;
	Welcome(int n){
		this.n = n;
	}
   
    
    public synchronized void run() {
        try {
            // write your code here
			for(int i=0;i&lt;n;i++){
				Thread.sleep(400);
				System.out.println("Welcome");
			}
            
            
            
        }
        catch (Exception e) {
            System.out.println(e);
