l-font-monospace" data-ref="b9b90d81-c4ec-4afd-8728-8dd1b167a21d">start()</span><strong data-ref="192767c9-7937-4b58-9e02-09daba94e122">.</strong></li><li data-ref="f8f2bfbf-0ee9-41dd-b525-a02e0075fcc2">Refer to visible test cases for better understanding and to match with input/output layout.</li></ul></span></div><div class="mb-3" data-ref="5bf0d504-5388-4595-afcc-191de9d072e7"><div class="ml-1 mb-3" data-ref="48da4d87-a030-4900-a243-4cab316340c5"><b style="border-bottom:1px solid black;" data-ref="2ae844db-a5e8-4625-9107-4b5b74ee5e04" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="cd140b07-ae74-44e0-8a2a-730edbed3194" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="6c9fbe5b-a701-4e1a-8bc7-e62407bbb7b8" data-undisplayed="undisplayed">DaemonThread.java</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="85b7d3aa-16ca-4543-b1a5-ac1d27a73d9f" data-undisplayed="undisplayed">import java.util.Scanner;

class WorkerThread extends Thread {
	WorkerThread(String name){
		super(name);
	}
	public void run(){
		System.out.println(getName() + " started");
		try{
			Thread.sleep(500);
		}catch(InterruptedException e){
			System.out.println(e);
		}
		System.out.println(getName() + " finished");
	}
	// Write your code here...
	
	
	
	

}

public class DaemonThread {
	public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the number of user threads: ");
        int numUserThreads = scanner.nextInt();

        System.out.print("Enter the number of daemon threads: ");
        int numDaemonThreads = scanner.nextInt();
        
        // Create user threads
		for(int i=1;i&lt;=numUserThreads;i++){
			WorkerThread t = new WorkerThread("Thread " + i);
			t.start();
		}
        
        
        
        // Create daemon threads
		for(int i = 1;i &lt;= numDaemonThreads;i++){
			WorkerThread t = new WorkerThread("Thread " + i);
			t.setDaemon(true);
			t.start();
		}
        
        
        
        
        System.out.println("Main thread exiting");
